{
  "manifest_version": 3,
  "name": "TRUSTTRACE AI",
  "version": "0.1.0",
  "description": "User-controlled browser observation and privacy-policy text extraction.",
  "permissions": ["activeTab", "scripting", "webRequest", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TRUSTTRACE AI",
    "default_popup": "popup.html"
  }
}
